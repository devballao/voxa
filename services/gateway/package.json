{
  "name": "@voxa/gateway",
  "version": "0.0.0",
  "private": true,
  "description": "Gateway WebSocket do Voxa: entrega eventos em tempo real",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src/",
    "test:integration": "vitest run --mode integration test/integration/",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@voxa/protocol": "workspace:*",
    "iovalkey": "0.4.0",
    "pino": "10.3.1",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/ws": "8.18.2",
    "@voxa/config": "workspace:*",
    "@vitest/coverage-v8": "5.0.3",
    "pino-pretty": "13.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
