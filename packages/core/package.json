{
  "name": "@voxa/core",
  "version": "0.0.0",
  "private": true,
  "description": "Domínio do backend do Voxa: serviços, regras e erros tipados",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src/",
    "test:integration": "vitest run --mode integration test/integration/",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@voxa/protocol": "workspace:*",
    "iovalkey": "0.4.0"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@voxa/config": "workspace:*",
    "@vitest/coverage-v8": "5.0.3",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
