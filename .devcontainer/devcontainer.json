// Dev Container do Voxa: GitHub Codespaces ou VS Code (Dev Containers).
// Ao abrir: instala as dependências e roda `pnpm bootstrap` (infraestrutura + migrações).
// Depois, é só rodar `pnpm dev` no terminal.
{
  "name": "Voxa",
  // Ubuntu 24.04, versão fixa da imagem base oficial.
  "image": "mcr.microsoft.com/devcontainers/base:3.0.9-noble",

  "features": {
    // Node 24 LTS (mesma versão do .nvmrc). O pnpm vem do corepack (campo packageManager).
    "ghcr.io/devcontainers/features/node:2.1.1": {
      "version": "24",
      "pnpmVersion": "none"
    },
    // Docker dentro do contêiner: a infraestrutura de dev roda com Docker Compose.
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.3": {}
  },

  // Máquina mínima testada (Codespace de 2 vCPU e 8 GB).
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },

  // Roda uma vez, ao criar o contêiner (pode ser feito num prebuild do Codespaces).
  "onCreateCommand": "corepack enable && pnpm install --frozen-lockfile",
  // Precisa do Docker no ar: sobe a infraestrutura e aplica as migrações.
  "postCreateCommand": "pnpm bootstrap",

  "forwardPorts": [5173, 3000, 4000, 7880, 8025, 3900],
  "portsAttributes": {
    "5173": { "label": "Voxa · app web", "onAutoForward": "notify" },
    "3000": { "label": "Voxa · API", "onAutoForward": "silent" },
    "4000": { "label": "Voxa · gateway", "onAutoForward": "silent" },
    "7880": { "label": "LiveKit", "onAutoForward": "silent" },
    "8025": { "label": "Mailpit (e-mails de dev)", "onAutoForward": "silent" },
    "3900": { "label": "Garage (S3)", "onAutoForward": "silent" }
  },

  "customizations": {
    "vscode": {
      // As mesmas de .vscode/extensions.json.
      "extensions": ["biomejs.biome", "editorconfig.editorconfig", "bierner.markdown-mermaid"]
    }
  },

  "remoteUser": "vscode"
}
