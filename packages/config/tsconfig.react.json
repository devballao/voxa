{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Voxa — app web (React + Vite)",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2024", "dom", "dom.iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true
  }
}
