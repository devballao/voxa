{
  "name": "@voxa/api",
  "version": "0.0.0",
  "private": true,
  "description": "API REST do Voxa",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src/",
    "test:integration": "vitest run --mode integration test/integration/",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1145.0",
    "@voxa/db": "workspace:*",
    "@voxa/protocol": "workspace:*",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "iovalkey": "0.4.0",
    "livekit-server-sdk": "2.19.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@voxa/config": "workspace:*",
    "@vitest/coverage-v8": "5.0.3",
    "pino-pretty": "13.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
