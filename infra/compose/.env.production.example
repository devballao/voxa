# Voxa em produção: copie com scripts/gerar-segredos.sh (cria o .env e preenche os segredos).
# O .env fica só no servidor e é ignorado pelo git. Nunca faça commit dele.

# --- Instância (preencha) ---
# Domínio público, sem https:// (ex.: voxa.exemplo.org). "localhost" para testar na sua máquina.
VOXA_DOMINIO=localhost
# E-mail para o Let's Encrypt (avisos de certificado expirando). Obrigatório.
VOXA_EMAIL_ACME=
# Versão das imagens: "main" (a mais recente) ou "sha-<commit>" para fixar uma versão.
VOXA_VERSAO=main
# IP público do servidor, usado pela mídia (voz e vídeo). Em teste local: 127.0.0.1.
VOXA_IP_PUBLICO=127.0.0.1
LOG_LEVEL=info

# --- Segredos: ficam vazios aqui; scripts/gerar-segredos.sh preenche no .env ---
POSTGRES_PASSWORD=
VALKEY_PASSWORD=
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
GARAGE_METRICS_TOKEN=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
