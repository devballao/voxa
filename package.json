{
  "name": "voxa",
  "private": true,
  "description": "Plataforma de comunicação em comunidade, livre e sem fins lucrativos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devballao/voxa.git"
  },
  "packageManager": "pnpm@12.8.2",
  "engines": {
    "node": ">=24.11.0 <25",
    "pnpm": ">=12.8.2"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "turbo": "2.11.6",
    "typescript": "7.0.2"
  }
}
