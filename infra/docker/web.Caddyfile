# Serve o app web (SPA) na porta 80. Rotas desconhecidas caem no index.html.
:80 {
	root * /srv
	encode zstd gzip

	# Arquivos com hash no nome mudam a cada build: cache longo.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"

	try_files {path} /index.html
	file_server
}
