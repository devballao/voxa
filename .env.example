# Variáveis de ambiente para DESENVOLVIMENTO LOCAL.
# Copie para .env (ignorado pelo git): cp .env.example .env
# Todos os valores abaixo são públicos e valem só para a infraestrutura de
# infra/compose/docker-compose.dev.yml. Nunca use esses valores em produção.

# API
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgres://voxa:voxa@localhost:5432/voxa

# Valkey (compatível com Redis)
VALKEY_URL=redis://localhost:6379

# Armazenamento S3 (Garage)
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=voxa-dev
S3_ACCESS_KEY_ID=GK766f78612d6465762d6b6579
S3_SECRET_ACCESS_KEY=766f78612d6465762d7365637265742d6170656e61732d706172612d6465763031
S3_FORCE_PATH_STYLE=true

# LiveKit (servidor de mídia)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=voxa-dev-key
LIVEKIT_API_SECRET=voxa-dev-secret-apenas-para-desenvolvimento-local

# E-mail (Mailpit captura tudo; interface em http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM="Voxa (dev) <nao-responda@voxa.localhost>"
